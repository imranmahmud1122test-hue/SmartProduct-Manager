{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Tenant isolated inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "unit": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "openingStock": { "type": "number" },
        "totalReceived": { "type": "number" },
        "totalSold": { "type": "number" },
        "stockAdjustments": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockLevel": { "type": "number" },
        "maxStockLevel": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "archived", "draft"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "category", "sku", "sellingPrice", "currentStock", "status"]
    },
    "Business": {
      "title": "Business",
      "description": "Multi-tenant supermarket / retail store workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "currencySymbol": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerEmail", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "totalAmount": { "type": "number" },
        "orderStatus": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "businessId", "customerName", "customerPhone", "totalAmount", "orderStatus"]
    },
    "Movement": {
      "title": "Inventory Movement",
      "description": "Stock audit ledger movement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "businessId", "productId", "type", "quantity", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Central shared product catalog collection with tenant isolation and public viewing"
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Registered business tenants"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Marketplace and store customer orders"
    },
    "/movements/{movementId}": {
      "schema": "Movement",
      "description": "Historical inventory movements"
    }
  }
}
