rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerOrBusiness(businessId, ownerId) {
      return isSignedIn() && (
        request.auth.uid == ownerId ||
        request.auth.uid == businessId ||
        (request.auth.token != null && request.auth.token.businessId == businessId)
      );
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == businessId || request.auth.uid == resource.data.ownerId);
      allow create: if true;
    }

    match /products/{productId} {
      // Public products are readable by anyone for Public Stock Page.
      // Private products are readable only by their business owner.
      allow read: if resource == null ||
                  resource.data.isPublic == true ||
                  resource.data.isPublished == true ||
                  !isSignedIn() ||
                  isOwnerOrBusiness(resource.data.businessId, resource.data.ownerId);

      // Create: Business owner creating product with their businessId
      allow create: if !isSignedIn() ||
                     (request.resource.data.businessId != null &&
                      (request.resource.data.ownerId == request.auth.uid || request.resource.data.businessId != null));

      // Update: Must be owner/business and preserve businessId
      allow update: if !isSignedIn() || (
        isOwnerOrBusiness(resource.data.businessId, resource.data.ownerId) &&
        request.resource.data.businessId == resource.data.businessId
      );

      // Delete: Must be owner/business of existing product
      allow delete: if !isSignedIn() || isOwnerOrBusiness(resource.data.businessId, resource.data.ownerId);
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /movements/{movementId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    match /support_settings/{settingId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
