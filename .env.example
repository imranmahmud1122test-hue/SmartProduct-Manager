# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Environment Variables (For Render.com or custom hosting):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Production Email & SMTP Configuration:
# For Gmail SMTP (Standard local / VPS / Google Cloud Run environments):
# 1. Enable 2-Step Verification on your Google account.
# 2. Go to https://myaccount.google.com/apppasswords and generate a 16-character App Password.
# 3. Set SMTP_USER to your Gmail and SMTP_PASS to the 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=imranmahmud1122.test@gmail.com
SMTP_PASS=soundzfwlnnfpmsm
SMTP_FROM=imranmahmud1122.test@gmail.com

# HTTP Email APIs (Recommended for Render.com free tier where outbound SMTP ports 25, 465, 587 are blocked):
# Resend (https://resend.com):
RESEND_API_KEY=
RESEND_FROM=
# Brevo (https://brevo.com):
BREVO_API_KEY=
# SendGrid (https://sendgrid.com):
SENDGRID_API_KEY=

# Optional: Separate Frontend-Backend API URL (if hosting React SPA on Vercel/Netlify and Backend on Render):
VITE_API_URL=


